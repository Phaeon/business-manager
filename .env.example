# Copiez ce fichier en .env et adaptez les valeurs (ne jamais commiter le .env réel)

DB_NAME=business_manager
DB_USER=postgres
DB_PASSWORD=postgres

# Doit faire au moins 32 caractères en production
JWT_SECRET=change-this-secret-in-production-min-32-chars-long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Compte administrateur créé au premier démarrage (base vide)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin1234!

# true = crée des clients / devis / factures / projets de démonstration (+ comptes lea@demo.com et marc@demo.com, mot de passe Demo1234!)
APP_SEED_DEMO=true
